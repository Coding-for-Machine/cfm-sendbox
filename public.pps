#!/usr/bin/env -S cfm ppman spec

# Public sendbox packages
# Defines packages to be installed on the public installation.
# Format: <language glob> [semver range]; "!" removes matches again.

# Everything, newest version of each language
* *

# Languages where an LTS line is kept alongside the newest release
!node *
node 24.*
node 22.*
!java *
java 25.*
java 21.*
!julia *
julia 1.10.*
julia 1.13.*

# Python: current + the 3.12 line, no python2
!python *
python 3.15.*
python 3.12.*
