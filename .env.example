# Copy to .env (cp .env.example .env). Never commit .env.
# docker compose passes every CFM_* variable below to the API container.

# API keys (comma separated). Empty = no authentication.
# Generate one with: openssl rand -hex 32
CFM_API_KEYS=

# Package indexes (comma separated, first wins). Leave unset for the default:
# cfm-sendbox releases + upstream Piston.
# CFM_REPO_URL=https://github.com/Coding-for-Machine/cfm-sendbox/releases/download/pkgs/index

# Logging: DEBUG | INFO | WARN | ERROR | NONE
CFM_LOG_LEVEL=INFO

# Limits (see docs/configuration.md for the full list)
# CFM_RUN_TIMEOUT=3000
# CFM_COMPILE_TIMEOUT=10000
# CFM_MAX_CONCURRENT_JOBS=64
