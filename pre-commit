#!/bin/sh
# Install with: ln -s ../../pre-commit .git/hooks/pre-commit
echo "Checking Go formatting..."
FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.go$')
[ -z "$FILES" ] && exit 0

BAD=$(echo "$FILES" | xargs gofmt -l)
if [ -n "$BAD" ]; then
    echo "gofmt needed (run: make fmt):"
    echo "$BAD"
    exit 1
fi
go vet ./... || exit 1
exit 0
